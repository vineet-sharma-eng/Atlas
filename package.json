{
  "name": "atlas",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "concurrently \"yarn dev:api\" \"yarn dev:web\"",
    "dev:api": "nodemon --legacy-watch --watch server\\src --watch server server\\src\\server.js",
    "dev:web": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node server/src/server.js",
    "install:all": "yarn install",
    "db:setup": "node server/db/migrations.js",
    "up": "docker compose up -d && yarn && yarn dev",
    "down": "docker compose down"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "ollama": "^0.6.3",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.19"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14"
  }
}
