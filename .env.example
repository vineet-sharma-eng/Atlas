APP_NAME=Atlas Orchestrator
ATLAS_OPENAI_MODEL_ID=atlas

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_MS=30000
OLLAMA_MAX_RETRIES=1

ATLAS_INTERNAL_API_BASE_URL=http://127.0.0.1:5001
ATLAS_INTERNAL_API_TIMEOUT_MS=5000

JSON_BODY_LIMIT=1mb
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

VITE_API_PROXY_TARGET=http://127.0.0.1:5001
VITE_API_BASE_URL=

FINANCE_INSIGHTS_CRON=0 9 * * 0
GYM_INSIGHTS_CRON=0 8 */2 * *
GYM_TIPS_CRON=0 7 */2 * *
MOTIVATION_CRON=0 7 * * *

FINANCE_INSIGHTS_TTL_HOURS=168
GYM_INSIGHTS_TTL_HOURS=48
TIPS_TTL_HOURS=48
MOTIVATION_TTL_HOURS=24

FINANCE_INSIGHTS_MIN_ENTRIES=3
GYM_INSIGHTS_MIN_ENTRIES=3
TIPS_MIN_ENTRIES=5
MOTIVATION_MIN_ENTRIES=7
MOTIVATION_BATCH_SIZE=7

MOTIVATION_CLOUD_API_URL=https://openrouter.ai/api/v1/chat/completions
MOTIVATION_CLOUD_API_KEY=
MOTIVATION_CLOUD_MODEL=
MOTIVATION_CLOUD_TIMEOUT_MS=12000

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/atlas
APP_BASE_URL=http://127.0.0.1:5001
